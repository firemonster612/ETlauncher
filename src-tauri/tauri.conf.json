{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "etlauncher",
	"version": "0.1.0-beta",
	"identifier": "com.efox.etlauncher",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "ETLauncher",
				"width": 1200,
				"height": 800,
				"minWidth": 900,
				"minHeight": 600,
				"decorations": false,
				"maximized": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "app", "dmg"],
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"entitlements": "entitlements.plist",
			"signingIdentity": "-"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGRjk3MzYwNkI5RTA0MTAKUldRUUJKNXJZSFA1djd4T0hpV0Q5dktkbEtpNTlwOFJlWEpRYUxxZ2pxM3V4SE0zdW9rVUpOWEEK",
			"endpoints": [
				"https://github.com/firemonster612/ETlauncher/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
