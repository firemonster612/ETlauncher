{
	"name": "etlauncher",
	"version": "0.1.2",
	"description": "An Alien's Minecraft Launcher",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check-rs --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check-rs --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"validate": "bun run lint && bun run format:check && bun run check",
		"validate:rs": "cd src-tauri && cargo lint && cargo fmt-check",
		"tauri": "tauri",
		"tauri:build": "bun scripts/tauri-build.ts",
		"tauri:strip-appimage": "scripts/strip-appimage.sh"
	},
	"license": "MIT",
	"dependencies": {
		"@lucide/svelte": "^1.7.0",
		"@tauri-apps/api": "2.10.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-dialog": "2.7.0",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-process": "^2",
		"@tauri-apps/plugin-updater": "2.10.1",
		"bits-ui": "^2.17.2",
		"clsx": "^2.1.1",
		"dompurify": "^3.3.3",
		"marked": "^17.0.6",
		"mode-watcher": "^1.1.0",
		"skinview3d": "^3.4.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"three": "^0.183.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.2",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.11.0",
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.52.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@tauri-apps/cli": "^2",
		"@types/dompurify": "^3.2.0",
		"@types/three": "^0.182.0",
		"eslint": "^10.0.0",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"svelte": "^5.51.3",
		"svelte-check-rs": "^0.9.2",
		"tailwindcss": "4",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.56.0",
		"vite": "^7.3.1"
	}
}
